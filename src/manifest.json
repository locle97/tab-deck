{
  "manifest_version": 3,
  "name": "Tab Desk",
  "version": "0.1.0",
  "description": "Manage tab groups from one page: switch groups, save them as workspaces, and jump anywhere with Ctrl+K.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "storage", "favicon", "scripting"],
  "optional_host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Tab Desk",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open Tab Desk"
    },
    "open-palette": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open Tab Desk with the search palette"
    }
  }
}
